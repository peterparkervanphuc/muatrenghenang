title Arkanoid Game - OOP Class Diagram v2.1\nUpdated: November 6, 2025

' ============================================
' ABSTRACT BASE CLASSES
' ============================================

abstract class GameObject {
    # x: double
    # y: double
    # width: int
    # height: int

    + GameObject(x, y, width, height)
    + {abstract} update(): void
    + {abstract} render(g2d: Graphics2D): void
    + getBounds(): Rectangle
    + intersects(rect: Rectangle): boolean
    + getX(): double
    + getY(): double
    + setX(x: double): void
    + setY(y: double): void
    + getWidth(): int
    + getHeight(): int
}

abstract class MovableObject extends GameObject {
    # velocityX: double
    # velocityY: double
    # speed: double

    + MovableObject(x, y, width, height, speed)
    + update(): void
    + move(dx, dy): void
    + setVelocity(vx, vy): void
    + stop(): void
    + getVelocityX(): double
    + getVelocityY(): double
    + setVelocityX(vx: double): void
    + setVelocityY(vy: double): void
    + getSpeed(): double
    + setSpeed(speed: double): void
}

' ============================================
' GAME ENTITIES
' ============================================

class Ball extends MovableObject {
    - BALL_SIZE: int {static, final}
    - INITIAL_SPEED: double {static, final}
    - MAX_SPEED: double {static, final}
    - radius: int
    - attached: boolean
    - attachedPaddle: Paddle
    - ballImage: BufferedImage
    - speedMultiplier: double
    - levelSpeedBonus: double

    + Ball(x, y)
    + Ball(x, y, level)
    + attachToPaddle(paddle: Paddle): void
    + launch(): void
    + bounceOffPaddle(paddle: Paddle): void
    + bounceOffBrick(brick: Brick): void
    + slow(): void
    + restoreNormalSpeed(): void
    + setVelocity(dx, dy): void
    + intersects(rect: Rectangle): boolean
    + isAttached(): boolean
    + getSpeedMultiplier(): double
    + getLevelSpeedBonus(): double
    + setSpeedMultiplier(m: double): void
    + setLevelSpeedBonus(b: double): void
    + setAttached(attached: boolean): void
}

class Paddle extends MovableObject {
    - SPEED: int {static, final}
    - NORMAL_WIDTH: int {static, final}
    - NORMAL_HEIGHT: int {static, final}
    - ENLARGED_WIDTH: int {static, final}
    - LASER_COOLDOWN: long {static, final}
    - enlarged: boolean
    - hasLaser: boolean
    - hasCatch: boolean
    - paddleImage: BufferedImage
    - laserPaddleImage: BufferedImage
    - enlargedImage: BufferedImage
    - laserBeams: ArrayList<LaserBeam>
    - lastLaserTime: long

    + Paddle(x, y, enlarged: boolean)
    + moveLeft(): void
    + moveRight(): void
    + enlarge(): void
    + shrink(): void
    + enableLaser(): void
    + disableLaser(): void
    + enableCatch(): void
    + disableCatch(): void
    + fireLaser(): void
    + isEnlarged(): boolean
    + hasLaser(): boolean
    + hasCatch(): boolean
    + getLasers(): ArrayList<LaserBeam>
}

class Powerup extends MovableObject {
    - POWERUP_WIDTH: int {static, final}
    - POWERUP_HEIGHT: int {static, final}
    - FALL_SPEED: int {static, final}
    - type: PowerupType
    - powerupImage: BufferedImage

    + Powerup(x, y)
    + Powerup(x, y, type: PowerupType)
    + intersects(rect: Rectangle): boolean
    + getType(): PowerupType
}

class LaserBeam extends MovableObject {
    - LASER_WIDTH: int {static, final}
    - LASER_HEIGHT: int {static, final}
    - LASER_SPEED: int {static, final}
    - active: boolean
    - laserImage: BufferedImage

    + LaserBeam(x, y)
    + isActive(): boolean
    + setActive(active: boolean): void
}

class Brick extends GameObject {
    - BRICK_WIDTH: int {static, final}
    - BRICK_HEIGHT: int {static, final}
    - type: BrickType
    - hits: int
    - brickImage: BufferedImage
    - dx: double

    + Brick(x, y, type: BrickType)
    + {static} byId(id: int): BrickType
    + hit(): void
    + isDestroyed(): boolean
    + isSilver(): boolean
    + isBreakable(): boolean
    + getPoints(): int
    + getType(): BrickType
    + getHits(): int
    + getHitsRemaining(): int
    + setHitsRemaining(hits: int): void
}

' ============================================
' ENUMS
' ============================================

enum BrickType {
    WHITE(1, 1, 50, "path", true)
    ORANGE(2, 1, 60, "path", true)
    LIGHT_BLUE(3, 1, 70, "path", true)
    GREEN(4, 1, 80, "path", true)
    RED(5, 1, 90, "path", true)
    BLUE(6, 1, 100, "path", true)
    PURPLE(7, 1, 110, "path", true)
    YELLOW(8, 1, 120, "path", true)
    SILVER(9, 3, 150, "path", true)
    GOLD(10, 1, 0, "path", false)
    MOVING_UNBREAKABLE_RF(11, 1, 0, "path", false, 1.5)
    MOVING_UNBREAKABLE_LF(12, 1, 0, "path", false, 1.5)
    MOVING_RF(13, 1, 100, "path", true, 1.5)
    MOVING_LF(14, 1, 100, "path", true, 1.5)

    - id: int
    - maxHits: int
    - points: int
    - imagePath: String
    - isBreakable: boolean
    - initialSpeed: double

    + getId(): int
    + getMaxHits(): int
    + getPoints(): int
    + getImagePath(): String
    + isBreakable(): boolean
    + getInitialSpeed(): double
}

enum PowerupType {
    ENLARGE("Sprites/Powerups/Enlarge.png")
    LASER("Sprites/Powerups/Laser.png")
    CATCH("Sprites/Powerups/Catch.png")
    SLOW("Sprites/Powerups/Slow.png")
    DUPLICATE("Sprites/Powerups/Duplicate.png")
    BREAK("Sprites/Powerups/Break.png")
    PLAYER("Sprites/Powerups/Player.png")

    - imagePath: String

    + getImagePath(): String
}

Brick +-- BrickType
Powerup +-- PowerupType

' ============================================
' FACTORY CLASSES (Factory Pattern)
' ============================================

class BrickFactory <<Factory>> {
    + {static} createBrick(id: int, x, y): Brick
    + {static} createSilverBrick(x, y): Brick
    + {static} createRandomBrick(x, y): Brick
}

class PowerUpFactory <<Factory>> {
    + {static} createPowerUp(type, x, y): Powerup
    + {static} createRandomPowerUp(x, y): Powerup
    + {static} createPowerUpFromBrick(x, y, chance): Powerup
    + {static} createBonusPowerUp(x, y): Powerup
}

BrickFactory ..> Brick : <<creates>>
PowerUpFactory ..> Powerup : <<creates>>

