    + GameManager()
    + resetGame(): void
    + addScore(points: int): void
    + getScore(): int
    + loseLife(): void
    + addLife(): void
    + getLives(): int
    + nextLevel(): void
    + getCurrentLevel(): int
    + isGameOver(): boolean
    + setGameOver(gameOver: boolean): void
    + isPaddleEnlarged(): boolean
    + setPaddleEnlarged(enlarged: boolean): void
}

class LevelManager {
    + {static} loadLevel(level: int): ArrayList<Brick>
}

class GameBounds {
    + {static} WINDOW_WIDTH: int
    + {static} WINDOW_HEIGHT: int
    + {static} PLAY_LEFT: int
    + {static} PLAY_RIGHT: int
    + {static} PLAY_TOP: int
    + {static} PLAY_BOTTOM: int
    + {static} PLAY_WIDTH: int
    + {static} PLAY_HEIGHT: int
}

LevelManager ..> Brick : <<creates>>
LevelManager ..> BrickFactory : <<uses>>

' ============================================
' MANAGER CLASSES (Singleton Pattern)
' ============================================

class ConfigManager <<Singleton>> {
    - {static} instance: ConfigManager
    - properties: Properties

    - ConfigManager()
    + {static} getInstance(): ConfigManager
    + getInt(key, defaultValue): int
    + getDouble(key, defaultValue): double
    + getBoolean(key, defaultValue): boolean
    + getString(key, defaultValue): String
    + getWindowWidth(): int
    + getWindowHeight(): int
    + getWindowTitle(): String
    + isSoundEnabled(): boolean
}

class SoundManager <<Singleton>> {
    - {static} instance: SoundManager
    - soundClips: HashMap<String, Clip>
    - soundEnabled: boolean

    - SoundManager()
    + {static} getInstance(): SoundManager
    + playMenuMusic(): void
    + stopMenuMusic(): void
    + playHighScoresMusic(): void
    + playGameStartSound(): void
    + playGameOverSound(): void
    + playWinSound(): void
    + playWallHitSound(): void
    + playSilverWallHitSound(): void
    + playShipHitSound(): void
    + playDeathSound(): void
    + playLaserBeamSound(): void
    + playLaserBeamHitSound(): void
    + playEnlargePowerupSound(): void
    + playPlayerPowerupSound(): void
    + playBreakPowerupSound(): void
    + stopAllMusic(): void
}

class HighScoreManager <<Singleton>> {
    - {static} HIGH_SCORE_FILE: String

    + {static} loadHighScores(): ArrayList<ScoreEntry>
    + {static} saveHighScores(scores): void
    + {static} addScore(name, score): boolean
    + {static} isHighScore(score): boolean
}

class SaveGameManager <<Singleton>> {
    - {static} instance: SaveGameManager
    - SAVE_DIR: String

    - SaveGameManager()
    + {static} getInstance(): SaveGameManager
    + saveGame(slot: int, state): boolean
    + loadGame(slot: int): GameState
    + hasSaveData(slot: int): boolean
    + deleteSave(slot: int): boolean
}

class FontManager <<Singleton>> {
    - {static} gameFont: Font

    + {static} getGameFont(size: float): Font
    + {static} getGameFont(style, size): Font
}

HighScoreManager +-- ScoreEntry
SaveGameManager +-- GameState
SaveGameManager +-- BallState
SaveGameManager +-- BrickState
SaveGameManager +-- PowerupState

class ScoreEntry {
    + name: String
    + score: int
    + timestamp: long
}

class GameState {
    + score: int
    + lives: int
    + currentLevel: int
    + gameOver: boolean
    + paddleEnlarged: boolean
    + paddleX: double
    + paddleY: double
    + balls: List<BallState>
    + bricks: List<BrickState>
    + powerups: List<PowerupState>
    + saveTimestamp: long
}

class BallState {
    + x, y: double
    + velocityX, velocityY: double
    + attached: boolean
    + speedMultiplier: double
    + levelSpeedBonus: double
}

class BrickState {
    + x, y: double
    + brickType: String
    + hitsRemaining: int
}

class PowerupState {
    + x, y: double
    + powerupType: String
}

' ============================================
' UI CLASSES
' ============================================

class ArkanoidGame extends JFrame {
    - cardLayout: CardLayout
    - mainPanel: JPanel
    - menuPanel: MenuPanel
    - gamePanel: GamePanel
    - highScorePanel: HighScorePanel

    + ArkanoidGame()
    + showMenu(): void
    + startNewGame(): void
    + showHighScores(): void
    + {static} main(args: String[]): void
}

class GamePanel extends JPanel {
    - gameManager: GameManager
    - gameTimer: Timer
    - paddle: Paddle
    - balls: ArrayList<Ball>
    - bricks: ArrayList<Brick>
    - powerups: ArrayList<Powerup>
    - breakableBricksCount: int
    - cameraShake: CameraShake
    - comboCounter: int
    - comboMultiplier: int
    - lastBrickHitTime: long
    - comboText: String
    - comboTextAlpha: int

    + GamePanel(mainFrame)
    + startNewGame(): void
    - initializeLevel(): void
    - update(): void
    - updateCombo(): void
    - resetCombo(): void
    - checkBallBrickCollision(ball): void
    - applyPowerup(powerup): void
    - levelCompleted(): void
    - saveGame(slot: int): void
    - loadGame(slot: int): void
    + paintComponent(g: Graphics): void
}

class MenuPanel extends JPanel {
    - selectedIndex: int
    - menuOptions: String[]

    + MenuPanel(mainFrame)
    - drawMenu(g2d): void
    + keyPressed(e: KeyEvent): void
}

class HighScorePanel extends JPanel {
    - highScores: ArrayList<ScoreEntry>

    + HighScorePanel(mainFrame)
    + refreshScores(): void
    - drawHighScores(g2d): void
}

